digraph G {
  graph [rankdir=LR bgcolor="#FFFFFF" fontname="Helvetica" nodesep=0.35 ranksep=1.4 pad=0.5 labelloc=t labeljust=l label=<<FONT POINT-SIZE="40" FACE="Gelasio"><B>Wikipedia (iOS) - architecture by topic</B></FONT><BR/><FONT POINT-SIZE="18" COLOR="#72777D">ios · main @ ca8aaeb · checked 2026-10-15</FONT><BR/> >];
