  "dark" [label=<<TABLE BORDER="3" COLOR="#3366CC" CELLBORDER="0" CELLSPACING="4" CELLPADDING="8" STYLE="rounded"><TR><TD COLSPAN="4"><FONT POINT-SIZE="26"><B>7 · Dark theme</B></FONT></TD></TR><TR><TD COLSPAN="4"><FONT POINT-SIZE="17" COLOR="#72777D">3 screens · 1 stories</FONT></TD></TR><TR><TD COLSPAN="4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/dark-home.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/dark-search-results.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/dark-article.png"/></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#14866D" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>1 built</B></FONT></TD></TR></TABLE>>];
