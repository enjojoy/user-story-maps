  "login" [label=<<TABLE BORDER="3" COLOR="#3366CC" CELLBORDER="0" CELLSPACING="4" CELLPADDING="8" STYLE="rounded"><TR><TD COLSPAN="4"><FONT POINT-SIZE="26"><B>2 · Login</B></FONT></TD></TR><TR><TD COLSPAN="4"><FONT POINT-SIZE="17" COLOR="#72777D">2 screens · 3 stories</FONT></TD></TR><TR><TD COLSPAN="4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/login.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/activity.png"/></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#14866D" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>2 built</B></FONT></TD><TD BGCOLOR="#6B8FD6" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>1 unverified</B></FONT></TD></TR></TABLE>>];
  "reading" [label=<<TABLE BORDER="3" COLOR="#3366CC" CELLBORDER="0" CELLSPACING="4" CELLPADDING="8" STYLE="rounded"><TR><TD COLSPAN="4"><FONT POINT-SIZE="26"><B>3 · Reading</B></FONT></TD></TR><TR><TD COLSPAN="4"><FONT POINT-SIZE="17" COLOR="#72777D">9 screens · 11 stories</FONT></TD></TR><TR><TD COLSPAN="4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/home.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/home-foryou.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/article.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/article-toc.png"/></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#14866D" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>9 built</B></FONT></TD><TD BGCOLOR="#6B8FD6" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>2 unverified</B></FONT></TD></TR></TABLE>>];
  "discover" [label=<<TABLE BORDER="3" COLOR="#3366CC" CELLBORDER="0" CELLSPACING="4" CELLPADDING="8" STYLE="rounded"><TR><TD COLSPAN="4"><FONT POINT-SIZE="26"><B>4 · Search and library</B></FONT></TD></TR><TR><TD COLSPAN="4"><FONT POINT-SIZE="17" COLOR="#72777D">5 screens · 5 stories</FONT></TD></TR><TR><TD COLSPAN="4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/search.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/search-results.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/saved.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/tabs-overview.png"/></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#14866D" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>4 built</B></FONT></TD><TD BGCOLOR="#6B8FD6" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>1 unverified</B></FONT></TD></TR></TABLE>>];
