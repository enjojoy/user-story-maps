digraph G {
  graph [rankdir=LR bgcolor="#FFFFFF" fontname="Helvetica" nodesep=0.5 ranksep=1.0 pad=0.5 labelloc=t labeljust=l label=<<FONT POINT-SIZE="40"><B>Plant Waterer - every screen and how you get there</B></FONT><BR/><FONT POINT-SIZE="18" COLOR="#5A7266">ios · demo build 1.0 · checked 2026-10-15</FONT><BR/> >];
  node [shape=plain fontname="Helvetica"];
  edge [fontname="Helvetica" fontsize=19 color="#3A7D5B" fontcolor="#204532" penwidth=2.6 arrowsize=1.3];
  subgraph "cluster_onboarding" { label=<<FONT POINT-SIZE="30"><B>1 · Getting started</B></FONT>> style="rounded,filled" fillcolor="#F2F6F1" color="#47843D" penwidth=3 margin=22;
  "welcome" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="259"><FONT POINT-SIZE="20"><B>Welcome</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="259" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/welcome.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="259"><FONT POINT-SIZE="17" COLOR="#418B66">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Built</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">welcome</FONT></TD></TR></TABLE>> tooltip="Welcome"];
  "add-plant" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="259"><FONT POINT-SIZE="20"><B>Add a plant</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="259" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/add-plant.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="259"><FONT POINT-SIZE="17" COLOR="#AEA951">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Partly built</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">add-plant</FONT></TD></TR></TABLE>> tooltip="Add a plant"];
  }
  subgraph "cluster_plants" { label=<<FONT POINT-SIZE="30"><B>2 · Plants and watering</B></FONT>> style="rounded,filled" fillcolor="#F2F7F3" color="#469660" penwidth=3 margin=22;
  "plant-list" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="259"><FONT POINT-SIZE="20"><B>My plants</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="259" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/plant-list.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="259"><FONT POINT-SIZE="17" COLOR="#AEA951">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Partly built</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">plant-list</FONT></TD></TR></TABLE>> tooltip="My plants"];
  "plant-detail" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="259"><FONT POINT-SIZE="20"><B>Plant detail</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="259" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/plant-detail.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="259"><FONT POINT-SIZE="17" COLOR="#AEA951">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Partly built</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">plant-detail</FONT></TD></TR></TABLE>> tooltip="Plant detail"];
  "watered" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="259"><FONT POINT-SIZE="20"><B>Watered! (confirmation)</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="259" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/watered.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="259"><FONT POINT-SIZE="17" COLOR="#AEA951">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Partly built</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">watered</FONT></TD></TR></TABLE>> tooltip="Watered! (confirmation)"];
  "water-history" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="258"><FONT POINT-SIZE="20"><B>Watering history</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="258" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/water-history.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="258"><FONT POINT-SIZE="17" COLOR="#AEA951">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Partly built</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">water-history</FONT></TD></TR></TABLE>> tooltip="Watering history"];
  }
  subgraph "cluster_reminders" { label=<<FONT POINT-SIZE="30"><B>3 · Reminders</B></FONT>> style="rounded,filled" fillcolor="#F1F6F5" color="#3D8476" penwidth=3 margin=22;
  "reminders" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="259"><FONT POINT-SIZE="20"><B>Reminder schedule</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="259" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/reminders.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="259"><FONT POINT-SIZE="17" COLOR="#AEA951">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Partly built</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">reminders</FONT></TD></TR></TABLE>> tooltip="Reminder schedule"];
  "notif-permission" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="259"><FONT POINT-SIZE="20"><B>Allow notifications (system<BR/>alert)</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="259" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/notif-permission.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="259"><FONT POINT-SIZE="17" COLOR="#41798B">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Unverified</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">notif-permission</FONT></TD></TR></TABLE>> tooltip="Allow notifications (system alert)"];
  "push" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="259"><FONT POINT-SIZE="20"><B>Reminder notification</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="259" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/push.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="259"><FONT POINT-SIZE="17" COLOR="#AEA951">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Partly built</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">push</FONT></TD></TR></TABLE>> tooltip="Reminder notification"];
  }
  subgraph "cluster_sharing" { label=<<FONT POINT-SIZE="30"><B>4 · Settings and sharing</B></FONT>> style="rounded,filled" fillcolor="#F2F6F7" color="#468196" penwidth=3 margin=22;
  "settings" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="259"><FONT POINT-SIZE="20"><B>Settings</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="259" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/settings.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="259"><FONT POINT-SIZE="17" COLOR="#AEA951">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Partly built</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">settings</FONT></TD></TR></TABLE>> tooltip="Settings"];
  "share-garden" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="258"><FONT POINT-SIZE="20"><B>Share my garden</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="258" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/share-garden.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="258"><FONT POINT-SIZE="17" COLOR="#8B9C94">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Missing</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">share-garden</FONT></TD></TR></TABLE>> tooltip="Share my garden"];
  "sitter-view" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="258"><FONT POINT-SIZE="20"><B>Sitter checklist</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="258" HEIGHT="519"><IMG SCALE="TRUE" SRC="../thumbs/sitter-view.png"/></TD></TR></TABLE></TD></TR><TR><TD WIDTH="258"><FONT POINT-SIZE="17" COLOR="#8B9C94">&#9679;</FONT> <FONT POINT-SIZE="15" COLOR="#364940"><B>Missing</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#81988C">sitter-view</FONT></TD></TR></TABLE>> tooltip="Sitter checklist"];
  }
  "welcome" -> "add-plant" [label=<<B>Tap Add my first plant</B>>];
  "welcome" -> "plant-list" [label=<<B>Tap Skip for now</B>>];
  "plant-list" -> "plant-detail" [label=<<B>Tap a plant card</B>>];
  "plant-list" -> "add-plant" [label=<<B>Tap +</B>>];
  "add-plant" -> "plant-list" [label=<<B>Tap Save</B>>];
  "plant-detail" -> "watered" [label=<<B>Tap Water now</B>>];
  "watered" -> "plant-list" [label=<<B>Tap Done</B>>];
  "plant-detail" -> "water-history" [label=<<B>Tap History</B>>];
  "plant-detail" -> "reminders" [label=<<B>Tap Edit reminder</B>>];
  "reminders" -> "notif-permission" [label=<<B>Tap Turn on reminders</B>>];
  "notif-permission" -> "push" [label=<<B>(Time passes) reminder<BR/>arrives</B>> style=dashed color="#96A69E" fontcolor="#5A7266"];
  "push" -> "plant-detail" [label=<<B>Tap the notification</B>>];
  "plant-list" -> "settings" [label=<<B>Tap Settings tab</B>>];
  "settings" -> "reminders" [label=<<B>Tap Default reminder<BR/>time</B>>];
  "settings" -> "share-garden" [label=<<B>Tap Share my garden</B>>];
  "share-garden" -> "sitter-view" [label=<<B>Send invite</B>>];
}
