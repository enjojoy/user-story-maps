digraph G {
  graph [rankdir=LR bgcolor="#FFFFFF" fontname="Helvetica" nodesep=0.5 ranksep=1.0 pad=0.5 labelloc=t labeljust=l label=<<FONT POINT-SIZE="40"><B>Plant Waterer - flows overview</B></FONT><BR/><FONT POINT-SIZE="18" COLOR="#5A7266">ios · demo build 1.0 · checked 2026-10-15</FONT><BR/> >];
  node [shape=plain fontname="Helvetica"];
  edge [fontname="Helvetica" fontsize=19 color="#3A7D5B" fontcolor="#204532" penwidth=2.6 arrowsize=1.3];
  "onboarding" [label=<<TABLE BORDER="3" COLOR="#3A7D5B" CELLBORDER="0" CELLSPACING="4" CELLPADDING="8" STYLE="rounded"><TR><TD COLSPAN="4"><FONT POINT-SIZE="26"><B>1 · Getting started</B></FONT></TD></TR><TR><TD COLSPAN="4"><FONT POINT-SIZE="17" COLOR="#5A7266">2 screens · 3 stories</FONT></TD></TR><TR><TD COLSPAN="4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="78" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/welcome.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="78" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/add-plant.png"/></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#418B66" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>2 built</B></FONT></TD><TD BGCOLOR="#AEA951" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>1 partly</B></FONT></TD></TR></TABLE>>];
  "plants" [label=<<TABLE BORDER="3" COLOR="#3A7D5B" CELLBORDER="0" CELLSPACING="4" CELLPADDING="8" STYLE="rounded"><TR><TD COLSPAN="4"><FONT POINT-SIZE="26"><B>2 · Plants and watering</B></FONT></TD></TR><TR><TD COLSPAN="4"><FONT POINT-SIZE="17" COLOR="#5A7266">4 screens · 5 stories</FONT></TD></TR><TR><TD COLSPAN="4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="78" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/plant-list.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="78" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/plant-detail.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="78" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/watered.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/water-history.png"/></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#418B66" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>2 built</B></FONT></TD><TD BGCOLOR="#AEA951" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>3 partly</B></FONT></TD></TR></TABLE>>];
  "reminders" [label=<<TABLE BORDER="3" COLOR="#3A7D5B" CELLBORDER="0" CELLSPACING="4" CELLPADDING="8" STYLE="rounded"><TR><TD COLSPAN="4"><FONT POINT-SIZE="26"><B>3 · Reminders</B></FONT></TD></TR><TR><TD COLSPAN="4"><FONT POINT-SIZE="17" COLOR="#5A7266">3 screens · 3 stories</FONT></TD></TR><TR><TD COLSPAN="4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="78" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/reminders.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="78" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/notif-permission.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="78" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/push.png"/></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#418B66" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>1 built</B></FONT></TD><TD BGCOLOR="#41798B" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>1 unverified</B></FONT></TD><TD BGCOLOR="#8B9C94" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>1 missing</B></FONT></TD></TR></TABLE>>];
  "sharing" [label=<<TABLE BORDER="3" COLOR="#3A7D5B" CELLBORDER="0" CELLSPACING="4" CELLPADDING="8" STYLE="rounded"><TR><TD COLSPAN="4"><FONT POINT-SIZE="26"><B>4 · Settings and sharing</B></FONT></TD></TR><TR><TD COLSPAN="4"><FONT POINT-SIZE="17" COLOR="#5A7266">3 screens · 5 stories</FONT></TD></TR><TR><TD COLSPAN="4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="78" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/settings.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/share-garden.png"/></TD><TD FIXEDSIZE="TRUE" WIDTH="77" HEIGHT="156"><IMG SCALE="TRUE" SRC="../thumbs/sitter-view.png"/></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#418B66" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>1 built</B></FONT></TD><TD BGCOLOR="#41798B" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>1 unverified</B></FONT></TD><TD BGCOLOR="#8B9C94" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="18"><B>3 missing</B></FONT></TD></TR></TABLE>>];
  "onboarding" -> "plants" [label=<<B>Tap Skip for now</B>>];
  "plants" -> "onboarding" [label=<<B>Tap +</B>>];
  "plants" -> "reminders" [label=<<B>Tap Edit reminder</B>>];
  "reminders" -> "plants" [label=<<B>Tap the notification</B>>];
  "plants" -> "sharing" [label=<<B>Tap Settings tab</B>>];
  "sharing" -> "reminders" [label=<<B>Tap Default reminder<BR/>time</B>>];
}
