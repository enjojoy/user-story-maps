digraph G {
  graph [rankdir=LR bgcolor="#FFFFFF" fontname="Helvetica" nodesep=0.35 ranksep=1.4 pad=0.5 labelloc=t labeljust=l label=<<FONT POINT-SIZE="40"><B>Plant Waterer - architecture by topic</B></FONT><BR/><FONT POINT-SIZE="18" COLOR="#5A7266">ios · demo build 1.0 · checked 2026-10-15</FONT><BR/> >];
  node [shape=plain fontname="Helvetica"];
  edge [fontname="Helvetica" fontsize=19 color="#3A7D5B" fontcolor="#204532" penwidth=2.6 arrowsize=1.3];
  subgraph "cluster_onboarding" { label=<<FONT POINT-SIZE="30" COLOR="#418B65"><B>Onboarding</B></FONT><BR/><FONT POINT-SIZE="17" COLOR="#5A7266">2 screens · 3 stories · 2 built · 1 partly</FONT>> labeljust=l style="rounded,filled" fillcolor="#F1F6F4" color="#418B65" penwidth=3.5 margin=22;
  "welcome" [label=<<TABLE BORDER="3" COLOR="#418B66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="rounded"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Welcome</B></FONT></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="86" HEIGHT="187"><IMG SCALE="TRUE" SRC="../thumbs/welcome.png"/></TD></TR></TABLE>> tooltip="Welcome"];
  "add-plant" [label=<<TABLE BORDER="3" COLOR="#AEA951" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="rounded"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Add a plant</B></FONT></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="86" HEIGHT="187"><IMG SCALE="TRUE" SRC="../thumbs/add-plant.png"/></TD></TR></TABLE>> tooltip="Add a plant"];
  }
  subgraph "cluster_journey" { label=<<FONT POINT-SIZE="30" COLOR="#41418B"><B>Main user journey</B></FONT><BR/><FONT POINT-SIZE="17" COLOR="#5A7266">4 screens · 5 stories · 2 built · 3 partly</FONT>> labeljust=l style="rounded,filled" fillcolor="#F1F1F6" color="#41418B" penwidth=3.5 margin=22;
  "plant-list" [label=<<TABLE BORDER="3" COLOR="#AEA951" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="rounded"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>My plants</B></FONT></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="86" HEIGHT="187"><IMG SCALE="TRUE" SRC="../thumbs/plant-list.png"/></TD></TR></TABLE>> tooltip="My plants"];
  "plant-detail" [label=<<TABLE BORDER="3" COLOR="#AEA951" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="rounded"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Plant detail</B></FONT></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="86" HEIGHT="187"><IMG SCALE="TRUE" SRC="../thumbs/plant-detail.png"/></TD></TR></TABLE>> tooltip="Plant detail"];
  "watered" [label=<<TABLE BORDER="3" COLOR="#AEA951" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="rounded"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Watered!<BR/>(confirmation)</B></FONT></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="86" HEIGHT="187"><IMG SCALE="TRUE" SRC="../thumbs/watered.png"/></TD></TR></TABLE>> tooltip="Watered! (confirmation)"];
  "water-history" [label=<<TABLE BORDER="3" COLOR="#AEA951" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="dashed"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Watering history</B></FONT></TD></TR><TR><TD WIDTH="110" HEIGHT="70" BGCOLOR="#F0F4F2"><FONT POINT-SIZE="11" COLOR="#5A7266">not captured</FONT></TD></TR></TABLE>> tooltip="Watering history"];
  }
  subgraph "cluster_notifications" { label=<<FONT POINT-SIZE="30" COLOR="#8B4167"><B>Reminders</B></FONT><BR/><FONT POINT-SIZE="17" COLOR="#5A7266">3 screens · 3 stories · 1 built · 1 unverified · 1 missing</FONT>> labeljust=l style="rounded,filled" fillcolor="#F6F1F4" color="#8B4167" penwidth=3.5 margin=22;
  "reminders" [label=<<TABLE BORDER="3" COLOR="#AEA951" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="rounded"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Reminder schedule</B></FONT></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="86" HEIGHT="187"><IMG SCALE="TRUE" SRC="../thumbs/reminders.png"/></TD></TR></TABLE>> tooltip="Reminder schedule"];
  "notif-permission" [label=<<TABLE BORDER="3" COLOR="#41798B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="rounded"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Allow<BR/>notifications<BR/>(system alert)</B></FONT></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="86" HEIGHT="187"><IMG SCALE="TRUE" SRC="../thumbs/notif-permission.png"/></TD></TR></TABLE>> tooltip="Allow notifications (system alert)"];
  "push" [label=<<TABLE BORDER="3" COLOR="#AEA951" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="rounded"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Reminder<BR/>notification</B></FONT></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="86" HEIGHT="187"><IMG SCALE="TRUE" SRC="../thumbs/push.png"/></TD></TR></TABLE>> tooltip="Reminder notification"];
  }
  subgraph "cluster_settings" { label=<<FONT POINT-SIZE="30" COLOR="#8B8B41"><B>Settings &amp; sharing</B></FONT><BR/><FONT POINT-SIZE="17" COLOR="#5A7266">3 screens · 5 stories · 1 built · 1 unverified · 3 missing</FONT>> labeljust=l style="rounded,filled" fillcolor="#F6F6F1" color="#8B8B41" penwidth=3.5 margin=22;
  "settings" [label=<<TABLE BORDER="3" COLOR="#AEA951" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="rounded"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Settings</B></FONT></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="86" HEIGHT="187"><IMG SCALE="TRUE" SRC="../thumbs/settings.png"/></TD></TR></TABLE>> tooltip="Settings"];
  "share-garden" [label=<<TABLE BORDER="3" COLOR="#8B9C94" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="dashed"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Share my garden</B></FONT></TD></TR><TR><TD WIDTH="110" HEIGHT="70" BGCOLOR="#F0F4F2"><FONT POINT-SIZE="11" COLOR="#5A7266">not captured</FONT></TD></TR></TABLE>> tooltip="Share my garden"];
  "sitter-view" [label=<<TABLE BORDER="3" COLOR="#8B9C94" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="dashed"><TR><TD WIDTH="120" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Sitter checklist</B></FONT></TD></TR><TR><TD WIDTH="110" HEIGHT="70" BGCOLOR="#F0F4F2"><FONT POINT-SIZE="11" COLOR="#5A7266">not captured</FONT></TD></TR></TABLE>> tooltip="Sitter checklist"];
  }
  "welcome" -> "add-plant" [color="#96A69E" penwidth=1.6 arrowsize=0.8];
  "welcome" -> "plant-list" [color="#418B65" fontcolor="#418B65" penwidth=4.2 arrowsize=1.4 fontsize=15 label=<<B>Tap Skip for now</B>>];
  "plant-list" -> "plant-detail" [color="#96A69E" penwidth=1.6 arrowsize=0.8];
  "plant-list" -> "add-plant" [color="#41418B" fontcolor="#41418B" penwidth=4.2 arrowsize=1.4 fontsize=15 label=<<B>Tap +</B>>];
  "add-plant" -> "plant-list" [color="#418B65" fontcolor="#418B65" penwidth=4.2 arrowsize=1.4 fontsize=15 label=<<B>Tap Save</B>>];
  "plant-detail" -> "watered" [color="#96A69E" penwidth=1.6 arrowsize=0.8];
  "watered" -> "plant-list" [color="#96A69E" penwidth=1.6 arrowsize=0.8];
  "plant-detail" -> "water-history" [color="#96A69E" penwidth=1.6 arrowsize=0.8];
  "plant-detail" -> "reminders" [color="#41418B" fontcolor="#41418B" penwidth=4.2 arrowsize=1.4 fontsize=15 label=<<B>Tap Edit reminder</B>>];
  "reminders" -> "notif-permission" [color="#96A69E" penwidth=1.6 arrowsize=0.8];
  "notif-permission" -> "push" [color="#96A69E" penwidth=1.6 arrowsize=0.8 style=dashed];
  "push" -> "plant-detail" [color="#8B4167" fontcolor="#8B4167" penwidth=4.2 arrowsize=1.4 fontsize=15 label=<<B>Tap the notification</B>>];
  "plant-list" -> "settings" [color="#41418B" fontcolor="#41418B" penwidth=4.2 arrowsize=1.4 fontsize=15 label=<<B>Tap Settings tab</B>>];
  "settings" -> "reminders" [color="#8B8B41" fontcolor="#8B8B41" penwidth=4.2 arrowsize=1.4 fontsize=15 label=<<B>Tap Default reminder<BR/>time</B>>];
  "settings" -> "share-garden" [color="#96A69E" penwidth=1.6 arrowsize=0.8];
  "share-garden" -> "sitter-view" [color="#96A69E" penwidth=1.6 arrowsize=0.8];
  "reminders" -> "settings" [style=invis weight=0.3];
}
